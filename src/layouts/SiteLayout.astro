---
import '../styles/guide.css';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'trs1' | 'trs2';
}

const {
  title,
  description = '티어링 사가 시리즈 한글패치 배포와 공략·게임 데이터 아카이브',
  active = 'home',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | 티어링 사가 아카이브</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={base} aria-label="티어링 사가 아카이브 홈">
          <strong>티어링 사가 한국어 패치</strong>
        </a>
        <nav class="primary-nav" aria-label="주요 메뉴">
          <a class:list={{ active: active === 'home' }} href={base}>홈</a>
          <a class:list={{ active: active === 'trs1' }} href={`${base}trs1/releases/`}>티어링 사가</a>
          <a class:list={{ active: active === 'trs2' }} href={`${base}trs2/releases/`}>베르위크 사가</a>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        <strong>패치 제작: soaptree</strong> · 버그 제보 및 문의:
        <a href="mailto:soaptree45@gmail.com">soaptree45@gmail.com</a>
      </p>
      <p>비공식 팬 프로젝트 · 게임 본편, 디스크 이미지와 BIOS는 제공하지 않습니다.</p>
    </footer>
  </body>
</html>
