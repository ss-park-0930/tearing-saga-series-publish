---
import { getCollection, type CollectionEntry } from 'astro:content';
import GuideLayout from '../../../layouts/GuideLayout.astro';
import { allEntities, entityTypeLabels, type GameEntity } from '../../../lib/entities';

export async function getStaticPaths() {
  const chapters = await getCollection('trs1Chapters');
  return allEntities.map((entity) => ({
    params: { id: entity.id },
    props: {
      entity,
      chapters: chapters.filter((entry) => entry.data.relatedIds.includes(entity.id)),
    },
  }));
}

interface Props {
  entity: GameEntity;
  chapters: CollectionEntry<'trs1Chapters'>[];
}

const { entity, chapters } = Astro.props;
const base = import.meta.env.BASE_URL;
const categoryByType = {
  character: 'characters',
  weapon: 'equipment',
  item: 'items',
  class: 'classes',
  skill: 'skills',
};
---

<GuideLayout title={entity.provisionalKo ?? entity.displayName} description={`${entityTypeLabels[entity.type]} ${entity.provisionalKo ?? entity.displayName} 표기와 관련 공략`}>
  <div class="guide-shell entity-detail-shell">
    <nav class="breadcrumb" aria-label="현재 위치">
      <a href={`${base}trs1/guides/`}>티어링 사가</a>
      <span aria-hidden="true">/</span>
      <a href={`${base}trs1/catalog/${categoryByType[entity.type]}/`}>{entityTypeLabels[entity.type]}</a>
      <span aria-hidden="true">/</span><span>{entity.provisionalKo ?? entity.displayName}</span>
    </nav>

    <article class="entity-detail-card">
      <p class="eyebrow">{entityTypeLabels[entity.type]}</p>
      <h1>{entity.provisionalKo ?? entity.displayName}</h1>
      {entity.provisionalKo && <p class="original-name" lang="ja">{entity.displayName}</p>}
      {entity.introduction && <p class="entity-introduction">{entity.introduction}</p>}

      <dl class="entity-meta-list">
        <div><dt>분류</dt><dd>{entityTypeLabels[entity.type]}</dd></div>
        <div><dt>일본어 기준명</dt><dd lang="ja">{entity.canonicalJp}</dd></div>
      </dl>

      <section class="related-guides" aria-labelledby="related-guides-title">
        <h2 id="related-guides-title">등장하는 파일럿 공략</h2>
        {chapters.length ? (
          <div class="chapter-link-list">
            {chapters.map((chapter) => (
              <a href={`${base}trs1/${chapter.data.slug.toLowerCase()}/`}>
                <span>{chapter.data.chapter}장</span><strong>{chapter.data.title}</strong>
              </a>
            ))}
          </div>
        ) : <p>아직 연결된 파일럿 공략이 없습니다.</p>}
      </section>
    </article>
  </div>
</GuideLayout>
