---
import SiteLayout from '../layouts/SiteLayout.astro';
import { releaseGames } from '../lib/releases';

const base = import.meta.env.BASE_URL;

// Public build-time configuration. Both values are non-secret by design:
// the Turnstile site key is meant to ship in HTML, and the endpoint is a
// public URL. Fill them in the Pages deploy workflow (see worker/README.md).
const reportEndpoint = import.meta.env.PUBLIC_REPORT_ENDPOINT ?? '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const contactEmail = 'soaptree45@gmail.com';

const environments = ['실기(PS1/PS2)', 'DuckStation', 'ePSXe', 'PCSX2', '기타'];
const frequencies = [
  { value: 'always', label: '항상' },
  { value: 'sometimes', label: '가끔' },
  { value: 'once', label: '한 번만' },
];
// 30MB per file, mirrored by the Worker. Keep in sync with worker/worker.js.
const maxFileBytes = 30 * 1024 * 1024;
---

<SiteLayout
  title="버그 제보"
  description="티어링 사가 시리즈 한국어 패치의 버그를 로그인 없이 제보할 수 있습니다."
  active="home"
>
  <div class="page-shell">
    <nav class="breadcrumb" aria-label="현재 위치">
      <a href={base}>홈</a><span>/</span><span>버그 제보</span>
    </nav>
    <header class="page-header">
      <p class="overline">Bug report</p>
      <h1>버그 제보</h1>
      <p>
        패치 적용 중 발견한 문제를 알려주세요. GitHub 로그인 없이 제보할 수 있으며,
        연락처는 선택 사항입니다. 접수된 내용은 검토 후 처리합니다.
      </p>
    </header>

    {reportEndpoint === '' && (
      <p class="notice-text">
        제보 접수 서버가 아직 연결되지 않았습니다. 그동안은
        <a href={`mailto:${contactEmail}`}>{contactEmail}</a>으로 알려주세요.
      </p>
    )}

    <form
      id="report-form"
      class="report-form"
      novalidate
      data-endpoint={reportEndpoint}
      data-max-bytes={String(maxFileBytes)}
    >
      <div class="report-field">
        <label for="game">작품 <span class="req" aria-hidden="true">*</span></label>
        <select id="game" name="game" required>
          <option value="" selected disabled>선택하세요</option>
          <option value="trs1">{releaseGames.trs1.title}</option>
          <option value="trs2">{releaseGames.trs2.title}</option>
        </select>
        <p class="report-help">어떤 작품의 패치인지 선택하면 담당 저장소로 접수됩니다.</p>
      </div>

      <div class="report-field">
        <label for="version">패치 버전 <span class="req" aria-hidden="true">*</span></label>
        <input
          id="version"
          name="version"
          type="text"
          required
          maxlength="60"
          placeholder="예: v1.2.0 (릴리즈 페이지에서 확인)"
          autocomplete="off"
        />
      </div>

      <div class="report-field">
        <label for="environment">사용 환경 <span class="req" aria-hidden="true">*</span></label>
        <select id="environment" name="environment" required>
          <option value="" selected disabled>선택하세요</option>
          {environments.map((env) => <option value={env}>{env}</option>)}
        </select>
      </div>

      <div class="report-field">
        <label for="summary">증상 요약 <span class="req" aria-hidden="true">*</span></label>
        <input
          id="summary"
          name="summary"
          type="text"
          required
          maxlength="120"
          placeholder="한 줄 요약 (제보 제목이 됩니다)"
          autocomplete="off"
        />
      </div>

      <div class="report-field">
        <label for="steps">재현 경로 <span class="req" aria-hidden="true">*</span></label>
        <textarea
          id="steps"
          name="steps"
          required
          rows="6"
          maxlength="4000"
          placeholder="어디서 → 무엇을 하면 → 무엇이 일어나는지 순서대로 적어주세요."
        ></textarea>
      </div>

      <fieldset class="report-field report-radios">
        <legend>발생 빈도</legend>
        {frequencies.map((freq) => (
          <label class="report-radio">
            <input type="radio" name="frequency" value={freq.value} />
            <span>{freq.label}</span>
          </label>
        ))}
      </fieldset>

      <div class="report-field">
        <label for="screenshots">스크린샷 <span class="report-optional">(선택)</span></label>
        <input id="screenshots" name="screenshots" type="file" accept="image/*" multiple />
        <p class="report-help">이미지 파일. 여러 장 첨부할 수 있습니다.</p>
      </div>

      <div class="report-field">
        <label for="savefiles">세이브 파일 <span class="report-optional">(선택)</span></label>
        <input id="savefiles" name="savefiles" type="file" multiple />
        <p class="report-help">
          문제가 발생한 시점의 <strong>게임 내 세이브 파일</strong>(메모리 카드 파일)을 함께 보내주시면
          같은 상황을 그대로 재현해 볼 수 있어 원인 분석에 큰 도움이 됩니다.
          세이브 스테이트(중간 저장)는 에뮬레이터 종류와 버전이 다르면 열리지 않는 경우가 많아,
          가능하면 게임에서 저장한 세이브 파일을 첨부해 주세요.
        </p>
        <p class="report-help">형식 제한은 없습니다. (파일당 최대 30MB)</p>
        <p class="report-help">
          <button type="button" class="link-button" id="save-guide-open">
            세이브 파일이 어디에 있나요?
          </button>
        </p>
      </div>

      <div class="report-field">
        <label for="contact">연락처 <span class="report-optional">(선택)</span></label>
        <input
          id="contact"
          name="contact"
          type="text"
          maxlength="200"
          placeholder="이메일 등. 익명 제보를 원하면 비워 두세요."
          autocomplete="off"
        />
      </div>

      {/* Honeypot: hidden from humans, tempting to naive bots. Filled = dropped. */}
      <div class="report-hp" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      {turnstileSiteKey !== '' && (
        <div class="report-field">
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
        </div>
      )}

      <div class="report-actions">
        <button type="submit" class="primary-button" id="report-submit">제보 보내기</button>
        <p id="report-status" class="report-status" role="status" aria-live="polite"></p>
      </div>
    </form>

    <noscript>
      <p class="notice-text">
        이 폼은 JavaScript가 필요합니다. 사용이 어려우면
        <a href={`mailto:${contactEmail}`}>{contactEmail}</a>으로 제보해 주세요.
      </p>
    </noscript>

    <dialog id="save-guide" class="save-guide" aria-labelledby="save-guide-title">
      <div class="save-guide-head">
        <h2 id="save-guide-title">세이브 파일 위치 안내</h2>
        <button type="button" class="save-guide-close" id="save-guide-close" aria-label="닫기">✕</button>
      </div>
      <div class="save-guide-body">
        <p>
          여기서 말하는 세이브 파일은 <strong>게임 안에서 저장한 데이터</strong>, 즉 메모리 카드 파일입니다.
          에뮬레이터의 세이브 스테이트(중간 저장)와는 다른 파일입니다.
        </p>
        <p class="notice-text">
          세이브 스테이트는 에뮬레이터와 버전, 패치 적용 상태까지 일치해야 열리는 경우가 많습니다.
          두 가지가 모두 있다면 게임 내 세이브 파일을 우선 첨부해 주세요.
        </p>

        <h3>DuckStation (PS1)</h3>
        <ul>
          <li>
            Windows: <code>%USERPROFILE%\Documents\DuckStation\memcards\</code>
            <span class="save-guide-note">
              (파일 탐색기 주소창에 그대로 붙여넣으면 열립니다)
            </span>
          </li>
          <li>macOS: <code>~/Library/Application Support/DuckStation/memcards/</code></li>
          <li>Linux: <code>~/.local/share/duckstation/memcards/</code></li>
          <li>
            파일 확장자는 <code>.mcd</code>이며, 게임별 메모리 카드를 쓰는 경우
            <code>SLPS-03050_1.mcd</code>처럼 디스크 코드가 이름에 들어갑니다.
          </li>
          <li>
            메뉴에서 확인하려면 <strong>설정 → 메모리 카드</strong>에서 슬롯 1의 파일 경로를 보면 됩니다.
          </li>
          <li>
            포터블 모드로 쓰고 있다면 실행 파일이 있는 폴더 아래 <code>memcards</code> 폴더를 확인하세요.
          </li>
          <li>
            <code>savestates</code> 폴더의 파일은 세이브 스테이트이므로 대상이 아닙니다.
          </li>
        </ul>

        <h3>ePSXe (PS1)</h3>
        <ul>
          <li>
            Windows: ePSXe를 설치(압축 해제)한 폴더 아래 <code>memcards\</code>
          </li>
          <li>Linux: <code>~/.epsxe/memcards/</code></li>
          <li>
            기본 파일 이름은 <code>epsxe000.mcr</code>(슬롯 1), <code>epsxe001.mcr</code>(슬롯 2)입니다.
          </li>
          <li>
            메뉴에서 확인하려면 <strong>Config → Memory Cards</strong>에서 슬롯별 파일 경로를 보면 됩니다.
          </li>
          <li>
            <code>sstates</code> 폴더의 파일은 세이브 스테이트이므로 대상이 아닙니다.
          </li>
        </ul>

        <h3>PCSX2 (PS2)</h3>
        <ul>
          <li>
            Windows (1.7 이상 · 2.x): <code>%USERPROFILE%\Documents\PCSX2\memcards\</code>
          </li>
          <li>
            Windows (1.6 이하): 설치 폴더 아래 <code>memcards\</code>
          </li>
          <li>macOS: <code>~/Library/Application Support/PCSX2/memcards/</code></li>
          <li>Linux: <code>~/.config/PCSX2/memcards/</code></li>
          <li>
            기본 파일 이름은 <code>Mcd001.ps2</code>(슬롯 1), <code>Mcd002.ps2</code>(슬롯 2)입니다.
          </li>
          <li>
            메뉴에서는 <strong>설정 → 메모리 카드</strong>에서 사용 중인 카드와 폴더를 확인할 수 있습니다.
          </li>
          <li>
            폴더형 메모리 카드(<span lang="en">Folder Memory Card</span>)를 쓰고 있다면 파일 하나가 아니라
            폴더로 되어 있습니다. 그 폴더를 통째로 ZIP으로 압축해서 첨부해 주세요.
          </li>
          <li>
            <code>savestates</code> 폴더의 <code>.p2s</code> 파일은 세이브 스테이트이므로 대상이 아닙니다.
          </li>
        </ul>

        <h3>실기 (PS1 / PS2)</h3>
        <ul>
          <li>
            실제 메모리 카드에 저장된 데이터는 PC로 바로 복사할 수 없습니다. 메모리 카드 리더기나
            PS3의 메모리 카드 어댑터 등 별도 장비가 있어야 파일로 뽑아낼 수 있습니다.
          </li>
          <li>
            추출이 어렵다면 세이브 파일 없이 보내주셔도 됩니다. 대신 문제 장면의 스크린샷과
            그 직전에 무엇을 했는지 자세히 적어주시면 도움이 됩니다.
          </li>
        </ul>

        <h3>공통</h3>
        <ul>
          <li>
            어디에 있는지 모르겠다면, 에뮬레이터에서 <strong>메모리 카드</strong> 관련 설정 화면을 열어
            표시된 경로를 확인하는 방법이 가장 확실합니다.
          </li>
          <li>
            여러 파일을 보내야 하거나 폴더 형태라면 ZIP으로 묶어서 첨부해 주세요. (파일당 최대 30MB)
          </li>
          <li>
            세이브 파일에는 플레이 기록만 들어 있으며, 개인 정보는 포함되지 않습니다.
          </li>
        </ul>
      </div>
      <div class="save-guide-actions">
        <button type="button" class="primary-button" id="save-guide-done">닫기</button>
      </div>
    </dialog>
  </div>

  {turnstileSiteKey !== '' && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}

  <script is:inline>
    // Save-file location guide. Falls back to plain visibility toggling on
    // browsers without <dialog> support.
    const saveGuide = document.getElementById('save-guide');
    const openSaveGuide = document.getElementById('save-guide-open');

    function closeSaveGuide() {
      if (typeof saveGuide.close === 'function') saveGuide.close();
      else saveGuide.removeAttribute('open');
      openSaveGuide?.focus();
    }

    openSaveGuide?.addEventListener('click', () => {
      if (typeof saveGuide.showModal === 'function') saveGuide.showModal();
      else saveGuide.setAttribute('open', '');
    });
    document.getElementById('save-guide-close')?.addEventListener('click', closeSaveGuide);
    document.getElementById('save-guide-done')?.addEventListener('click', closeSaveGuide);
    // Click on the backdrop (i.e. outside the dialog box) closes it.
    saveGuide?.addEventListener('click', (event) => {
      if (event.target === saveGuide) closeSaveGuide();
    });
  </script>

  <script is:inline define:vars={{ maxFileBytes }}>
    const form = document.getElementById('report-form');
    const statusEl = document.getElementById('report-status');
    const submitBtn = document.getElementById('report-submit');
    const endpoint = form?.dataset.endpoint ?? '';

    function setStatus(message, kind) {
      statusEl.textContent = message;
      statusEl.dataset.kind = kind ?? '';
    }

    function totalFileBytes() {
      let total = 0;
      for (const input of form.querySelectorAll('input[type="file"]')) {
        for (const file of input.files) total += file.size;
      }
      return total;
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!endpoint) {
        setStatus('제보 서버가 아직 연결되지 않았습니다. 이메일로 보내주세요.', 'error');
        return;
      }
      if (!form.reportValidity()) return;

      // Enforce the size cap client-side too, so users get instant feedback.
      const oversize = [];
      for (const input of form.querySelectorAll('input[type="file"]')) {
        for (const file of input.files) {
          if (file.size > maxFileBytes) oversize.push(file.name);
        }
      }
      if (oversize.length) {
        setStatus(`파일이 30MB를 초과했습니다: ${oversize.join(', ')}`, 'error');
        return;
      }
      if (totalFileBytes() > maxFileBytes * 4) {
        setStatus('첨부 파일 전체 용량이 너무 큽니다. 일부만 첨부해 주세요.', 'error');
        return;
      }

      const turnstile = window.turnstile;
      const token = form.querySelector('[name="cf-turnstile-response"]')?.value;
      if (typeof turnstile !== 'undefined' && !token) {
        setStatus('사람인지 확인하는 절차를 완료해 주세요.', 'error');
        return;
      }

      submitBtn.disabled = true;
      setStatus('제보를 보내는 중입니다…', 'pending');

      try {
        const response = await fetch(endpoint, { method: 'POST', body: new FormData(form) });
        const data = await response.json().catch(() => ({}));
        if (response.ok && data.ok) {
          setStatus('제보가 접수되었습니다. 감사합니다!', 'success');
          form.reset();
          if (typeof turnstile !== 'undefined') turnstile.reset();
        } else if (response.status === 429) {
          setStatus('요청이 너무 많습니다. 잠시 후 다시 시도해 주세요.', 'error');
          if (typeof turnstile !== 'undefined') turnstile.reset();
        } else {
          setStatus(data.error ?? '제보 전송에 실패했습니다. 잠시 후 다시 시도해 주세요.', 'error');
          if (typeof turnstile !== 'undefined') turnstile.reset();
        }
      } catch (error) {
        setStatus('네트워크 오류로 전송하지 못했습니다. 잠시 후 다시 시도해 주세요.', 'error');
        if (typeof turnstile !== 'undefined') turnstile.reset();
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>
</SiteLayout>