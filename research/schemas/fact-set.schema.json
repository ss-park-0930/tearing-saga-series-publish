{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tear-ring-saga.local/schemas/fact-set.schema.json",
  "title": "Chapter fact set",
  "type": "object",
  "additionalProperties": false,
  "required": ["game", "subjectId", "generatedAt", "relatedEntityIds", "facts"],
  "properties": {
    "game": { "enum": ["trs1", "trs2"] },
    "subjectId": { "type": "string", "pattern": "^trs[12]-chapter-[0-9]{2}[ab]?$" },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "relatedEntityIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^trs[12]-(character|weapon|item|class|skill)-[a-z0-9-]+$" }
    },
    "facts": {
      "type": "array",
      "items": { "$ref": "fact.schema.json" }
    }
  }
}
